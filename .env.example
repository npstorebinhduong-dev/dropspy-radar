MODE=demo
DATABASE_URL=postgresql+psycopg://dropspy:dropspy@db:5432/dropspy
POSTGRES_USER=dropspy
POSTGRES_PASSWORD=dropspy
POSTGRES_DB=dropspy
API_URL=http://api:8000

# Opt in only for public pages you may access; access gates stop collection.
ENABLE_META_PUBLIC_COLLECTION=0

# Durable local import worker (set 0 only in isolated tests/manual job processing).
IMPORT_WORKER_ENABLED=1

# Phase 3A research CLI only: adapters stay disabled in sources.example.json.
# After external approval, configure tokens in secure environment settings (never Git).
# META_ACCESS_TOKEN / APIFY_TOKEN: no values included here.
# An operator-verified current Meta API version belongs in a private pilot config.
